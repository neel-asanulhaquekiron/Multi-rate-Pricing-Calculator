### Pricing Calculator API — VS Code "REST Client" extension (humao.rest-client)
### Click "Send Request" above any block. Cookies persist between requests
### automatically, so run "login" once and the authed requests work.

# Switch to the live URL by swapping the comment on these two lines:
# @baseUrl = http://localhost:3001
@baseUrl = https://multi-rate-pricing-calculator-serve-psi.vercel.app

### Health — expect {"ok":true,"db":true}
GET {{baseUrl}}/api/health

### Login as the seeded demo user — expect 200, sets the session cookie
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "demo@example.com",
  "password": "demo1234"
}

### Who am I — expect 200 with demo@example.com (run login first)
GET {{baseUrl}}/api/auth/me

### Logout — expect 204; running "Who am I" again now gives 401
POST {{baseUrl}}/api/auth/logout

### Signup a new account — expect 201 (edit the email to rerun, else 409)
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "email": "neel@example.com",
  "password": "password123"
}

### Login with wrong password — expect 401 INVALID_CREDENTIALS
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "demo@example.com",
  "password": "wrong-password"
}

### Signup with weak password — expect 400 with the specific message
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "email": "weak@example.com",
  "password": "short"
}

### Unknown endpoint — expect JSON 404
GET {{baseUrl}}/api/nope

###############################################################################
# Documents (login first — these need the session cookie)
###############################################################################

### List my documents
GET {{baseUrl}}/api/documents

### Create a document — expect 201, zero totals; COPY THE id FROM THE RESPONSE
# @name createDoc
POST {{baseUrl}}/api/documents
Content-Type: application/json

{
  "title": "My first quote",
  "customer": "Acme Corp",
  "issueDate": "2026-08-08"
}

@createResponseId = 0bd479f4-9208-46d5-b69a-b4c31b33a466

### Add Widget A (2 x 100.00, -10%, +5%) — replace :id with the document id
POST {{baseUrl}}/api/documents/{{createResponseId}}/lines
Content-Type: application/json

{
  "description": "Widget A",
  "quantity": 2,
  "unitPriceCents": 10000,
  "discount": { "type": "percent", "bp": 1000 },
  "taxBp": 500
}

### Add Widget B (1 x 50.00, +5%)
POST {{baseUrl}}/api/documents/{{createResponseId}}/lines
Content-Type: application/json

{
  "description": "Widget B",
  "quantity": 1,
  "unitPriceCents": 5000,
  "taxBp": 500
}

### Add Service fee (1 x 200.00, -$20 fixed) — totals should hit 42150 (421.50)
POST {{baseUrl}}/api/documents/{{createResponseId}}/lines
Content-Type: application/json

{
  "description": "Service fee",
  "quantity": 1,
  "unitPriceCents": 20000,
  "discount": { "type": "fixed", "cents": 2000 }
}

### Get the document with lines + totals
GET {{baseUrl}}/api/documents/{{createResponseId}}

### Finalize it — expect 200, status "finalized"
POST {{baseUrl}}/api/documents/{{createResponseId}}/finalize

### Try to edit after finalize — expect 409 DOCUMENT_FINALIZED
PUT {{baseUrl}}/api/documents/{{createResponseId}}
Content-Type: application/json

{
  "title": "Should fail",
  "customer": "Acme Corp",
  "issueDate": "2026-08-08"
}

### Duplicate into a new draft — expect 201, "(copy)" title
POST {{baseUrl}}/api/documents/{{createResponseId}}/duplicate
Content-Type: application/json

{
  "issueDate": "2026-08-08"
}

###############################################################################
# Report
###############################################################################

### Summary for August 2026 — count, grand total, tax, discount (drafts included)
GET {{baseUrl}}/api/reports/summary?from=2026-08-01&to=2026-08-31

### Report with from > to — expect 400 with specific message
GET {{baseUrl}}/api/reports/summary?from=2026-09-01&to=2026-08-01

### Validation demo: fixed discount above subtotal — expect 400 with message
POST {{baseUrl}}/api/documents/{{createResponseId}}/lines
Content-Type: application/json

{
  "description": "Too generous",
  "quantity": 1,
  "unitPriceCents": 5000,
  "discount": { "type": "fixed", "cents": 8000 }
}
